{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Backend",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Frontend",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend"
    }
